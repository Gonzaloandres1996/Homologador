<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <ApplicationIcon>Brand\ddc-isotipo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Brand\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homologador.Core\Homologador.Core.csproj" />
    <ProjectReference Include="..\Homologador.AzureApi\Homologador.AzureApi.csproj" />
  </ItemGroup>

</Project>
